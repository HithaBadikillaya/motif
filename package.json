{
  "name": "motif",
  "version": "0.1.0",
  "description": "A production-grade cross-platform CLI foundation for developer workflows.",
  "type": "module",
  "bin": {
    "motif": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "prepare": "husky"
  },
  "keywords": [
    "cli",
    "bun",
    "typescript",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "enquirer": "^2.4.1",
    "ink": "^5.0.1",
    "ora": "^8.1.0",
    "pino": "^9.3.2",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/bun": "^1.1.6",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "packageManager": "bun@1.1.20"
}
